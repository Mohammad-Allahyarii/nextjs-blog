// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// Enums
// ============================================================================

enum PostStatus {
  DRAFT
  PENDING
  PUBLISHED
  REJECTED
  ARCHIVED
}

enum CommentStatus {
  PENDING
  APPROVED
  REJECTED
  SPAM
}

// ============================================================================
// Blog domain models
// ============================================================================

model Category {
  id    Int    @id @default(autoincrement())
  name  String
  slug  String @unique
  // Back-relation only: not a real column.
  posts Post[]
}

model Tag {
  id    Int    @id @default(autoincrement())
  name  String
  slug  String @unique
  // Implicit many-to-many: Prisma creates the join table itself.
  posts Post[]
}

model Post {
  id              Int        @id @default(autoincrement())
  title           String
  slug            String     @unique
  excerpt         String?
  content         String
  coverImage      String?
  // Flow: DRAFT -> PUBLISHED (approval off, or author has post:publish)
  //       DRAFT -> PENDING -> PUBLISHED | REJECTED (approval on)
  // Staff take-down also uses REJECTED, with a reason shown to the author.
  status          PostStatus @default(DRAFT)
  // Shown to the author when the post is rejected.
  rejectionReason String?
  publishedAt     DateTime?
  reviewedAt      DateTime?
  reviewedById    String?
  authorId        String
  categoryId      Int?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  // Restrict: a user who still owns posts cannot be hard-deleted.
  // Ban the user or reassign the posts instead.
  author     User      @relation("PostAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  reviewedBy User?     @relation("PostReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tags       Tag[]
  comments   Comment[]

  // Admin review queue and public listing both filter by status first.
  @@index([status, publishedAt])
  @@index([authorId])
  @@index([categoryId])
}

model Comment {
  id            Int           @id @default(autoincrement())
  body          String
  status        CommentStatus @default(PENDING)
  postId        Int
  authorId      String
  // Top-level comments have parentId = null. Keep replies to one level.
  parentId      Int?
  moderatedById String?
  moderatedAt   DateTime?
  createdAt     DateTime      @default(now())

  post        Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  author      User      @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  moderatedBy User?     @relation("CommentModerator", fields: [moderatedById], references: [id], onDelete: SetNull)
  parent      Comment?  @relation("Replies", fields: [parentId], references: [id], onDelete: Cascade)
  replies     Comment[] @relation("Replies")

  // Moderation queue: pending comments ordered by age.
  @@index([status, createdAt])
  // Public listing of a post's approved comments.
  @@index([postId, status])
  // "All comments of this user" on the admin user-detail page.
  @@index([authorId])
  @@index([parentId])
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  actorId    String?
  // e.g. "user:ban", "user:set-role", "post:reject", "comment:delete"
  action     String
  // e.g. "user", "post", "comment"
  targetType String
  targetId   String
  meta       Json?
  createdAt  DateTime @default(now())

  // SetNull: the log entry survives even if the actor is deleted.
  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([targetType, targetId])
}

// Single-row table: always read and written with id = 1.
// Create the row lazily (upsert) the first time it is needed.
model SiteSetting {
  id                  Int      @id @default(1)
  // false: anyone can publish immediately.
  // true: posts from users without the `post:publish` permission go to
  // PENDING and wait for review.
  requirePostApproval Boolean  @default(false)
  updatedAt           DateTime @updatedAt
}

// ============================================================================
// Better Auth models (generated by the Better Auth CLI, admin plugin enabled)
// Do not edit these by hand: add custom user fields via `additionalFields`.
// ============================================================================

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  role          String?
  banned        Boolean?  @default(false)
  banReason     String?
  banExpires    DateTime?
  sessions      Session[]
  accounts      Account[]

  firstName String?
  lastName  String?

  // Back-relations for the blog domain (not real columns on "user").
  posts             Post[]     @relation("PostAuthor")
  reviewedPosts     Post[]     @relation("PostReviewer")
  comments          Comment[]  @relation("CommentAuthor")
  moderatedComments Comment[]  @relation("CommentModerator")
  auditLogs         AuditLog[] @relation("AuditActor")

  @@unique([email])
  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model RateLimit {
  id          String @id
  key         String
  count       Int
  lastRequest BigInt

  @@unique([key])
  @@map("rateLimit")
}
